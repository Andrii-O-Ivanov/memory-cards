{
  "plugins": [
    "plugins/markdown",
    "node_modules/better-docs/component"
  ],
  "source": {
    "include": ["src"],
    "includePattern": "\\.(jsx|js)$",
    "excludePattern": "(node_modules/|docs/)"
  },
  "opts": {
    "encoding": "utf8",
    "destination": "docs/",
    "recurse": true,
    "template": "node_modules/better-docs"
  }
}